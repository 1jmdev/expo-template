{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!.expo",
            "!dist",
            "!android",
            "!ios"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noUnknownAtRules": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    }
}
