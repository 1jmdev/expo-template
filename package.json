{
    "name": "mobile",
    "main": "src/main.tsx",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "android:prebuild": "expo prebuild --platform android",
        "android:apk": "bun run android:prebuild && bun run android:apk:release",
        "android:apk:clean": "expo prebuild --clean --platform android && bun run android:apk:release",
        "android:apk:release": "sh -c 'cd android && ./gradlew assembleRelease --parallel --build-cache --configure-on-demand -Dorg.gradle.workers.max=$(nproc)'",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check ."
    },
    "dependencies": {
        "@react-navigation/native": "^7.3.13",
        "@react-navigation/native-stack": "^7.18.5",
        "@rn-primitives/accordion": "^1.5.2",
        "@rn-primitives/alert-dialog": "^1.5.2",
        "@rn-primitives/aspect-ratio": "^1.5.2",
        "@rn-primitives/avatar": "^1.5.2",
        "@rn-primitives/checkbox": "^1.5.2",
        "@rn-primitives/collapsible": "^1.5.2",
        "@rn-primitives/context-menu": "^1.5.2",
        "@rn-primitives/dialog": "^1.5.2",
        "@rn-primitives/dropdown-menu": "^1.5.2",
        "@rn-primitives/hover-card": "^1.5.2",
        "@rn-primitives/label": "^1.5.2",
        "@rn-primitives/menubar": "^1.5.2",
        "@rn-primitives/popover": "^1.5.2",
        "@rn-primitives/portal": "^1.5.2",
        "@rn-primitives/progress": "^1.5.2",
        "@rn-primitives/radio-group": "^1.5.2",
        "@rn-primitives/select": "^1.5.2",
        "@rn-primitives/separator": "^1.5.2",
        "@rn-primitives/slot": "^1.5.2",
        "@rn-primitives/switch": "^1.5.2",
        "@rn-primitives/tabs": "^1.5.2",
        "@rn-primitives/toggle": "^1.5.2",
        "@rn-primitives/toggle-group": "^1.5.2",
        "@rn-primitives/tooltip": "^1.5.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "expo": "~57.0.7",
        "expo-splash-screen": "~57.0.4",
        "expo-system-ui": "~57.0.1",
        "lucide-react-native": "^1.25.0",
        "nativewind": "^4.2.6",
        "react": "19.2.7",
        "react-native": "0.86.0",
        "react-native-gesture-handler": "~3.1.0",
        "react-native-reanimated": "~4.5.2",
        "react-native-safe-area-context": "~5.8.0",
        "react-native-screens": "~4.26.2",
        "react-native-worklets": "0.11.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@types/react": "~19.2.17",
        "babel-preset-expo": "~57.0.3",
        "tailwindcss": "^3.4.17",
        "typescript": "~7.0.2"
    },
    "private": true
}
